# Copy to .env for local runs; set the same names in Vercel for production. Never commit real values.

# MongoDB connection string (Atlas: allow 0.0.0.0/0 under Network Access for Vercel)
MONGODB_URI=

# Long random string used to sign login and verification tokens
JWT_SECRET=

# Google AI Studio key for CV analysis and job scoring
GEMINI_API_KEY=
# Optional: defaults to gemini-3.6-flash
GEMINI_MODEL=

# RapidAPI key with access to the JSearch API
RAPIDAPI_KEY=

# Gmail address and app password for verification emails (optional locally)
EMAIL_USER=
EMAIL_PASS=

# Optional: base URL used in verification emails (defaults to the domain that served the request)
APP_URL=
