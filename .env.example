# Copy to .env for local runs; set the same names in Vercel for production. Never commit real values.

# MongoDB connection string (Atlas: allow 0.0.0.0/0 under Network Access for Vercel)
MONGODB_URI=

# Long random string used to sign login and verification tokens
JWT_SECRET=

# Google AI Studio key for CV analysis and job scoring
GEMINI_API_KEY=
# Optional: first model tried, defaults to gemini-3.5-flash-lite (falls back to 3.1-flash-lite, then 3.6-flash)
GEMINI_MODEL=

# RapidAPI key with access to the JSearch API
RAPIDAPI_KEY=
# Optional: several keys, comma-separated, instead of RAPIDAPI_KEY. Requests go to the key with the most
# quota left, a failed request moves to the next key at once, and a key that runs out of its monthly
# quota is skipped until it resets. Every key needs a JSearch subscription on its RapidAPI account.
RAPIDAPI_KEYS=
# Optional: milliseconds before a slow JSearch page gets a second, racing request (default 8000)
JSEARCH_HEDGE_MS=
# Optional: how long the extra pages of a search may take in total, in milliseconds (default 60000).
# JSearch pages by cursor, so pages come one after another; when this passes, the pages already
# fetched are used and the search stops asking for more.
JSEARCH_BUDGET_MS=
# Optional: JSearch pages per search (10 listings and one RapidAPI request each), defaults to 3
JOB_PAGES=
# Optional: JSearch pages per job title when the feed refreshes (up to 3 titles), defaults to 2
FEED_PAGES=

# Gmail address and app password for verification emails (optional locally)
EMAIL_USER=
EMAIL_PASS=

# Optional: base URL used in emails (defaults to the domain that served the request)
APP_URL=

# Optional: address shown on the privacy and terms pages for questions and data requests.
# Without it those pages ask people to reply to any email Pounce has sent them.
CONTACT_EMAIL=

# Long random string the schedulers send to /api/cron/alerts (Vercel Cron and .github/workflows/job-alerts.yml)
CRON_SECRET=
# Optional: JSearch pages per job title for each daily email, defaults to 1
ALERT_PAGES=
